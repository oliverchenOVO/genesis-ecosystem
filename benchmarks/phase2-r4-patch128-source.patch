diff --git a/crates/sim-core/src/resource_patches.rs b/crates/sim-core/src/resource_patches.rs
new file mode 100644
index 0000000..191d7dc
--- /dev/null
+++ b/crates/sim-core/src/resource_patches.rs
@@ -0,0 +1,115 @@
+//! Experimental integer spatial productivity; never a region or mating label.
+use crate::{spatial::CELL_SIZE, Cell};
+pub const PATCH_SCALE: i32 = 128;
+fn node(seed: u64, x: u64, y: u64) -> i64 {
+    let mut v = seed ^ x.wrapping_mul(0x9e3779b97f4a7c15) ^ y.wrapping_mul(0xd1b54a32d192ed03);
+    v = (v ^ (v >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);
+    v = (v ^ (v >> 27)).wrapping_mul(0x94d049bb133111eb);
+    v ^= v >> 31;
+    500 + (v % 1001) as i64
+}
+fn field(seed: u64, x: i32, y: i32) -> i64 {
+    let scale = i64::from(PATCH_SCALE);
+    let (cx, cy) = ((x / PATCH_SCALE) as u64, (y / PATCH_SCALE) as u64);
+    let (dx, dy) = (i64::from(x % PATCH_SCALE), i64::from(y % PATCH_SCALE));
+    (node(seed, cx, cy) * (scale - dx) * (scale - dy)
+        + node(seed, cx + 1, cy) * dx * (scale - dy)
+        + node(seed, cx, cy + 1) * (scale - dx) * dy
+        + node(seed, cx + 1, cy + 1) * dx * dy)
+        / (scale * scale)
+}
+pub fn initialize(seed: u64, size: i32, cells: &mut [Cell]) {
+    let side = (size / CELL_SIZE) as usize;
+    let raw = (0..cells.len())
+        .map(|i| {
+            let soft = field(
+                seed,
+                (i % side) as i32 * CELL_SIZE + CELL_SIZE / 2,
+                (i / side) as i32 * CELL_SIZE + CELL_SIZE / 2,
+            );
+            [soft, 2000 - soft]
+        })
+        .collect::<Vec<_>>();
+    let mut base = [0_i128; 2];
+    let mut weighted = [0_i128; 2];
+    for (cell, f) in cells.iter().zip(&raw) {
+        for (channel, n) in cell.base_productivity().into_iter().enumerate() {
+            base[channel] += i128::from(n);
+            weighted[channel] += i128::from(n) * i128::from(f[channel]);
+        }
+    }
+    for (cell, f) in cells.iter_mut().zip(raw) {
+        for channel in 0..2 {
+            cell.productivity_factors[channel] = if weighted[channel] == 0 {
+                1000
+            } else {
+                (i128::from(f[channel]) * base[channel] * 1000 / weighted[channel]) as u16
+            };
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn field_is_integer_continuous_positive_and_seeded() {
+        assert_ne!(field(0, 8, 8), field(1, 8, 8));
+        for seed in 0..8 {
+            for y in (8..512).step_by(16) {
+                for x in (8..496).step_by(16) {
+                    let v = field(seed, x, y);
+                    assert!((500..=1500).contains(&v));
+                    assert!(
+                        (v - field(seed, x + 16, y)).abs()
+                            <= 1000 * i64::from(CELL_SIZE) / i64::from(PATCH_SCALE) + 1
+                    );
+                }
+            }
+        }
+    }
+    #[test]
+    fn normalization_preserves_both_global_growth_budgets_without_rng() {
+        for seed in 0..8 {
+            let w = crate::World::new(crate::Config {
+                seed,
+                ..Default::default()
+            })
+            .unwrap();
+            let mut cells = w.state.environment.cells.clone();
+            initialize(seed, w.state.config.size, &mut cells);
+            assert_eq!(cells, w.state.environment.cells);
+            for channel in 0..2 {
+                let base = cells
+                    .iter()
+                    .map(|c| c.base_productivity()[channel])
+                    .sum::<i64>();
+                let scaled = cells
+                    .iter()
+                    .map(|c| c.productivity_numerators()[channel])
+                    .sum::<i64>();
+                assert!(scaled <= base * 1000 && base * 1000 - scaled < base);
+                assert!(cells
+                    .iter()
+                    .all(|c| (333..=3000).contains(&c.productivity_factors[channel])));
+            }
+        }
+    }
+    #[test]
+    fn restored_patch_carries_and_future_are_exact() {
+        let mut w = crate::World::new(crate::Config::default()).unwrap();
+        w.advance(1234);
+        let bytes = crate::persistence::encode(&w).unwrap();
+        let mut loaded = crate::persistence::decode(&bytes).unwrap();
+        assert_eq!(w.state.environment, loaded.state.environment);
+        w.advance(1000);
+        loaded.advance(1000);
+        assert_eq!(w.hash(), loaded.hash());
+        assert_eq!(
+            w.hash(),
+            crate::replay::Replay::from_world(&w)
+                .verify()
+                .unwrap()
+                .hash()
+        );
+    }
+}
