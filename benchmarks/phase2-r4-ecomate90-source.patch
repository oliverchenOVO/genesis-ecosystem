+/// R4 candidate: permille mate-acceptance factor from phenotype ecology only. Mean of four
+/// terms in [0, 1000]: mouth differs, bite capacity (30 units = 1000), temperature optimum
+/// (1000 = 10 degrees), and the nine-trait gate morphology profile distance (150 = 1000).
+fn eco_mate_factor(a: &Organism, b: &Organism, floor: i32) -> i32 {
+    let (ma, mb) = (&a.phenotype.morphology, &b.phenotype.morphology);
+    let profile = |o: &Organism| {
+        let m = &o.phenotype.morphology;
+        crate::analysis::morphology_profile([
+            m.segment_count * 1000,
+            m.mass,
+            m.armor,
+            m.bite_capacity,
+            m.locomotion_efficiency,
+            m.sensory_investment,
+            m.complexity,
+            o.phenotype.speed,
+            if m.mouth == crate::morphology::Mouth::Piercer { 1000 } else { 0 },
+        ])
+    };
+    let morphology = profile(a)
+        .iter()
+        .zip(profile(b))
+        .map(|(x, y)| (x - y).abs())
+        .sum::<i32>()
+        / 9;
+    let distance = (if ma.mouth == mb.mouth { 0 } else { 1000 }
+        + ((ma.bite_capacity - mb.bite_capacity).abs() * 1000 / 30).min(1000)
+        + (a.phenotype.temperature_optimum - b.phenotype.temperature_optimum)
+            .abs()
+            .min(1000)
+        + (morphology * 1000 / 150).min(1000))
+        / 4;
+    floor + (1000 - floor) * (1000 - distance) / 1000
+}
